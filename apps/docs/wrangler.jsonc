{
  // The documentation site: static assets, plus a small Worker that forwards
  // /api/install/* to the hosted installer (apps/installer). Build, then
  // deploy from the repository root, the installer first:
  //   pnpm --filter @appflare/docs build
  //   pnpm wrangler -c apps/installer/wrangler.jsonc deploy --env=""
  //   pnpm wrangler -c apps/docs/wrangler.jsonc deploy --env=""
  // That deploys the preview on workers.dev. The public site, appflare.dev, is
  // the `production` environment, deployed only by .github/workflows/docs.yml
  // to the account that owns the appflare.dev zone (apps/docs/README.md).
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "appflare-docs",
  // Pinned to the Appflare Dev account so local wrangler commands cannot target
  // another account. The production deploy drops this line from a copy of the
  // file at deploy time and names its account in CLOUDFLARE_ACCOUNT_ID, because
  // wrangler prefers this value over the environment variable.
  "account_id": "e56348678f83352622c33faa66f43c13",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  // Runs for the pages and /api/install/* (`run_worker_first` below), to hand
  // the installer its requests and to answer a page with its Markdown when the
  // request asks for it, and for paths that match no file; the build's own
  // files are served without it.
  "main": "./worker/index.ts",
  "assets": {
    // The prerendered site. `dist/server` holds the bundle the build renders
    // the pages with; it is never deployed.
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Each page is `<path>/index.html`.
    "html_handling": "auto-trailing-slash",
    // A path that matches no file reaches the Worker, which answers the
    // site's 404 page (`404.html`), or for a missing build file under
    // /assets/ a 404 that browsers never keep (worker/index.ts). Not
    // "404-page": `_headers`' one-year rule for /assets/* would go on that
    // 404 too, and a browser would keep it as the missing script for a year.
    "not_found_handling": "none",
    // The Worker runs first for the pages (`/` and every address ending in
    // `/`; html_handling redirects `/start/install` to `/start/install/`)
    // and for /api/install/*. Every other request is served from the files
    // without running it when one matches, and reaches it when none does.
    // Not "/*" with exclusions such as "!/assets/*": an excluded path never
    // reaches the Worker, so a missing file there would get the static
    // files' 404 with whatever `_headers` says for its path.
    "run_worker_first": ["/", "/*/", "/api/install/*"]
  },
  // The hosted installer, which has no address of its own. Bindings are not
  // inherited by environments, so `production` repeats it.
  "services": [{ "binding": "INSTALLER", "service": "appflare-installer" }],
  // Requests to /api/install/* carry the visitor's Cloudflare access token in
  // a header; no log of this Worker may record them.
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  "env": {
    // appflare.dev, in the account that owns the zone. Every other setting is
    // inherited from above; the account comes from CLOUDFLARE_ACCOUNT_ID.
    // www.appflare.dev is a Redirect Rule on the zone, not part of this Worker.
    "production": {
      "name": "appflare-docs",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "appflare.dev", "custom_domain": true }],
      "services": [{ "binding": "INSTALLER", "service": "appflare-installer" }]
    }
  }
}
